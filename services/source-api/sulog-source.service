[Unit]
Description=Sulog read-only Mastodon Source API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sulog-source
Group=sulog-source
WorkingDirectory=/opt/sulog-source
ExecStart=/usr/bin/node /opt/sulog-source/server.mjs
EnvironmentFile=/etc/sulog-source/config
LoadCredential=mastodon-token:/etc/sulog-source/mastodon-token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
MemoryMax=192M
TasksMax=32

[Install]
WantedBy=multi-user.target
